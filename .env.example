# ── Gridiron Desk configuration ───────────────────────────────────────────
# Copy to `.env` (or export in your shell) and fill in. Nothing here is
# committed. The app degrades gracefully when a key is missing — each feature
# that needs one says so instead of crashing.

# The LLM that turns English questions into structured queries.
# Get one at https://console.anthropic.com/  (required for /api/ask)
ANTHROPIC_API_KEY=

# Which Claude model parses questions. Defaults to claude-opus-5.
# claude-sonnet-5 is a cheaper, still-capable option for high volume.
GRIDIRON_MODEL=claude-opus-5

# Betting lines & props across major books (DraftKings, FanDuel, BetMGM, …).
# Free tier ~500 req/month at https://the-odds-api.com/  (required for /api/odds)
ODDS_API_KEY=

# Port for the local server.
PORT=8787

# No key needed for nflverse (GitHub) or ESPN.
